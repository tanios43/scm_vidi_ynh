#!/bin/bash
source /usr/share/yunohost/helpers

install_dir=$(ynh_app_setting_get --app=$app --key=install_dir)
data_dir=$(ynh_app_setting_get --app=$app --key=data_dir)
admin=$(ynh_app_setting_get --app=$app --key=admin)
secret_key=$(ynh_app_setting_get --app=$app --key=secret_key)
if [ -z "$secret_key" ]; then
    secret_key=$(openssl rand -hex 32)
    ynh_app_setting_set --app=$app --key=secret_key --value=$secret_key
fi

ynh_script_progression --message="Arrêt du service..." --weight=1
ynh_systemd_action --service_name="$app" --action="stop"

ynh_script_progression --message="Mise à jour des fichiers..." --weight=2
cp -r "$YNH_APP_BASEDIR/sources/." "$install_dir/"
chown -R "$app:$app" "$install_dir"

ynh_script_progression --message="Mise à jour des dépendances Python..." --weight=3
"$install_dir/venv/bin/pip" install --quiet --upgrade flask

ynh_script_progression --message="Mise à jour de la config..." --weight=1
ynh_add_nginx_config
ynh_add_systemd_config
ynh_replace_string --match_string="__ADMIN__"      --replace_string="$admin"      --target_file="/etc/systemd/system/$app.service"
ynh_replace_string --match_string="__SECRET_KEY__" --replace_string="$secret_key" --target_file="/etc/systemd/system/$app.service"
systemctl daemon-reload

ynh_script_progression --message="Redémarrage du service..." --weight=1
ynh_systemd_action --service_name="$app" --action="start"

ynh_script_progression --message="Mise à jour terminée !" --last
